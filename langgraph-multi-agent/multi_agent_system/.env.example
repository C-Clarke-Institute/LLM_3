# Required
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Optional CoinGecko Demo API key; public endpoints may work without one
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional
REQUEST_TIMEOUT_SECONDS=20
VEHICLE_SOURCES_ENABLED=true
TAVILY_API_KEY=
LOG_LEVEL=INFO
